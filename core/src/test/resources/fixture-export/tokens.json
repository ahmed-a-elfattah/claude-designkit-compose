{
  "color": {
    "$type": "color",
    "brand": {
      "500": { "$value": "#4F46E5" }
    },
    "primary": { "$value": "{color.brand.500}" },
    "on-primary": { "$value": "#FFFFFF" },
    "background": { "$value": "#FAFAFA" },
    "surface": { "$value": "#FFFFFF" },
    "danger": { "$value": "oklch(0.577 0.245 27.325)" }
  },
  "dark": {
    "color": {
      "$type": "color",
      "primary": { "$value": "#818CF8" },
      "background": { "$value": "#0A0A0A" },
      "surface": { "$value": "#171717" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "sans-serif"] }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "1rem" },
    "lg": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "md": {
      "$type": "shadow",
      "$value": { "color": "#00000022", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }
    }
  },
  "typography": {
    "display-lg": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "48px", "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": "-0.02em" }
    },
    "body-md": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "fontWeight": "regular", "lineHeight": "24px" }
    }
  }
}
